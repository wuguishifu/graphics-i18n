      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@graphics-i18n/core": "workspace:*",
    "fflate": "*",
    "tslib": "*"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=1.0.0",
    "react": ">=18",
    "react-native": ">=0.73"
