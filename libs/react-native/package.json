{
  "name": "@graphics-i18n/react-native",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuguishifu/graphics-i18n.git",
    "directory": "libs/react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
