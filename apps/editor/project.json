{
  "name": "editor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/editor",
  "projectType": "application",
  "tags": ["scope:hybrid"],
  "// targets": "to see all targets run: nx show project Graphics i18n --web",
  "targets": {
    "build-graphics": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["core"], "target": "build" }],
      "options": {
        "cwd": "apps/editor",
        "command": "node ../../libs/core/dist/tools/cli.js pack ../example-react-native/assets/graphics/summer-promo -o public/graphics/summer-promo.lpkg"
      }
    },
    "shadcn:add": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/editor",
        "command": "pnpm dlx shadcn@latest add {args}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,tsbuildinfo}",
          "transitive": true
        },
        { "fileset": "{projectRoot}/**/*.d.ts", "dependencies": true },
        { "externalDependencies": ["next", "typescript"] }
      ],
      "outputs": [
        "{projectRoot}/.next/types/**/*.ts",
        "{projectRoot}/dist/tsconfig.tsbuildinfo"
      ],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "options": {
        "cwd": "apps/editor",
        "command": "next typegen && tsc --project tsconfig.json --noEmit"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx dev editor",
        "cwd": "apps/editor"
      }
    },
    "dev": {
      "options": {
        "port": 3000
      }
    },
    "start": {
      "options": {
        "port": 3000
      }
    }
  }
}
